# Copy to .env.local and fill in. Never commit real secrets: these values end up in the
# public JavaScript bundle and are not secret anyway, but keep them out of git.

# Affiliate link from your partner dashboard (overrides the placeholder in src/config/affiliate.ts).
VITE_AFFILIATE_URL=

# Optional GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable GA4.
VITE_GA_MEASUREMENT_ID=
